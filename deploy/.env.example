# Copy to .env (next to compose.yml) and fill in. SETUP.md says where each
# value comes from. Never commit .env: .gitignore keeps it out.

# --- You and your tailnet --------------------------------------------------

# The login you use for Tailscale, e.g. you@gmail.com. Only this account gets
# into the Atlas apps (several, comma separated, if you ever want).
ATLAS_OWNER=

# Your tailnet's DNS name, from the Tailscale admin console's DNS page,
# e.g. tail1234.ts.net. The apps are then at https://<app>.<this>.
ATLAS_DOMAIN=

# A reusable auth key tagged tag:atlas, from Settings → Keys in the admin
# console. Only used the first time each app joins your tailnet.
TS_AUTHKEY=

# The apps that are running; the others show as "Not running yet".
ATLAS_APPS=atlas,kairos,hestia,milo,hygeia

# Your time zone, e.g. Europe/Madrid: greetings, due dates, Kairos's 03:00 backups.
TZ=UTC

# How dates and amounts are written, e.g. en-US (Nov 4, 2026; $1,234.50) or
# es-ES (4 nov 2026; 1234,50 €). The apps' words stay in English.
ATLAS_LOCALE=en-US

# Hestia's currency (ISO 4217: USD, EUR, ARS…). micasa saves it in its
# database the first time Hestia starts, and keeps that one afterwards.
ATLAS_CURRENCY=USD

# --- Database ---------------------------------------------------------------

# A long random password, made once (SETUP.md has a command).
POSTGRES_PASSWORD=

# --- Kairos (Dossier) -------------------------------------------------------

# A hash of the password you sign in to Kairos with, one line starting with
# argon2id: (SETUP.md has the command). Never the password itself.
DOSSIER_PASSWORD=

# Signs Kairos's sessions and encrypts the API keys it stores: 32+ random
# characters, made once. Changing it signs you out.
DOSSIER_SECRET=

# The Dossier release Kairos runs, from https://github.com/AienTech/dossier/releases
# DOSSIER_VERSION=v1.11.0

# Optional defaults for Kairos's AI provider (or choose in its Settings).
# Ollama on this computer: DOSSIER_AI_PROVIDER=local and
# DOSSIER_AI_URL=http://host.docker.internal:11434
# DOSSIER_AI_PROVIDER=
# DOSSIER_AI_URL=
# DOSSIER_AI_MODEL=
# DOSSIER_AI_KEY=

# Dossier's daily anonymous usage ping: on or off (unset, it asks you once).
# DOSSIER_TELEMETRY=off
