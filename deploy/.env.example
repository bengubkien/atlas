# Copy to .env (next to compose.yml) and fill in. SETUP.md says where each
# value comes from. Never commit .env: .gitignore keeps it out.

# --- You and your tailnet --------------------------------------------------

# The login you use for Tailscale, e.g. you@gmail.com. Only this account gets
# into the Atlas apps (several, comma separated, if you ever want).
ATLAS_OWNER=

# Your tailnet's DNS name, from the Tailscale admin console's DNS page,
# e.g. tail1234.ts.net. The apps are then at https://<app>.<this>.
ATLAS_DOMAIN=

# A reusable auth key tagged tag:atlas, from Settings → Keys in the admin
# console. Only used the first time each app joins your tailnet.
TS_AUTHKEY=

# The apps that are running; the others show as "Not running yet".
ATLAS_APPS=atlas,kairos,hestia,milo,hygeia,tyche,clio

# Your time zone, e.g. Europe/Madrid: greetings, due dates, Kairos's 03:00 backups.
TZ=UTC

# How dates and amounts are written, e.g. en-US (Nov 4, 2026; $1,234.50) or
# es-ES (4 nov 2026; 1234,50 €). The apps' words stay in English.
ATLAS_LOCALE=en-US

# Hestia's currency (ISO 4217: USD, EUR, ARS…). micasa saves it in its
# database the first time Hestia starts, and keeps that one afterwards.
ATLAS_CURRENCY=USD

# --- Database ---------------------------------------------------------------

# A long random password, made once (SETUP.md has a command).
POSTGRES_PASSWORD=

# --- Kairos (Dossier) -------------------------------------------------------

# A hash of a password for Kairos, one line starting with argon2id: (SETUP.md
# has the command). Never the password itself. Tailscale signs you in, so it's
# only asked for if you take ATLAS_OWNER away; Kairos won't start without one.
DOSSIER_PASSWORD=

# Signs Kairos's sessions and encrypts the API keys it stores: 32+ random
# characters, made once. Changing it signs you out.
DOSSIER_SECRET=

# Optional defaults for Kairos's AI provider (or choose in its Settings).
# Ollama on this computer: DOSSIER_AI_PROVIDER=local and
# DOSSIER_AI_URL=http://host.docker.internal:11434
# DOSSIER_AI_PROVIDER=
# DOSSIER_AI_URL=
# DOSSIER_AI_MODEL=
# DOSSIER_AI_KEY=

# Dossier's daily anonymous usage ping: on or off (unset, it asks you once).
# DOSSIER_TELEMETRY=off

# --- Tyche ------------------------------------------------------------------

# Where Tyche's server gets the day's dollar quotes, a few times a day. It
# syncs them to your devices, so the phone has them offline. This is the
# default; to use another source, put its address here. To turn fetching off
# and type the rates in yourself, set it empty (TYCHE_RATES_URL=).
# TYCHE_RATES_URL=https://dolarapi.com/v1/dolares

# Your IOL (InvertirOnline) login, so Tyche can read your investments' value
# and holdings every few hours. First ask IOL to switch on API access for
# you: in IOL, Mi cuenta, then contact them with "Api" as the reason. Tyche
# only reads; it never places an order. Like everything in this file, it
# stays on this computer (and in your backups, locked with your passphrase).
# Leave them empty to not connect.
TYCHE_IOL_USERNAME=
TYCHE_IOL_PASSWORD=

# --- Clio -------------------------------------------------------------------

# Nothing to set yet. Writing texts (step 7c) will need a Claude API key here,
# and their audio (step 7d) an Azure Speech key; both stay on the server.

# --- Backups ----------------------------------------------------------------

# The folder the backups go to: an external drive or a cloud-synced folder,
# e.g. D:\Backups\Atlas or C:\Users\you\OneDrive\Atlas backups. Unset,
# they go to the backups folder next to this file.
ATLAS_BACKUP_DIR=

# Locks every backup. Keep it in your password manager: without it, nobody
# can open them, you included. Changing it later leaves the old ones locked
# with the old one.
ATLAS_BACKUP_PASSPHRASE=

# How often, in hours, and how many days of backups to keep (the newest
# three are always kept).
# ATLAS_BACKUP_EVERY_HOURS=24
# ATLAS_BACKUP_KEEP_DAYS=30
